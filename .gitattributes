# 默认让 Git 自动处理文本文件的行尾归一化。
* text=auto

# 以下文件会在 Linux 容器内执行/被解析，必须使用 LF 行尾，
# 否则 Windows 的 CRLF 会破坏 shebang 或配置解析（如 nginx entrypoint）。
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
nginx.conf      text eol=lf
*.conf          text eol=lf
docker-entrypoint.sh text eol=lf

# Windows 批处理保持 CRLF。
*.bat           text eol=crlf
*.cmd           text eol=crlf
